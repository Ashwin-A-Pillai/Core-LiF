# |  6.000000 | 1.050000 | 1.050000 |        # [EXTQP BSK BSS] E parameters  (c/v) eV|adim|adim
# | %
# | EXCTemp= 0.000000          eV    # Excitonic Temperature (for luminescence spectra and EXCPH)
# | % BSEQptR
# |  1 | 1 |                             # [BSK] Transferred momenta range
# | %
# | % BSEBands
# |   1 | 20 |                           # [BSK] Bands range
# | %
# | BSEFrozenBands= "2 - 5"          # [BSK] Bands expluded from BSE construction
# | #NoDiagSC                      # New setup for non-diagonal supercells
# | % BEnRange
# |   0.00000 | 10.00000 |         eV    # [BSS] Energy range
# | %
# | BDmType= "Lorentzian"            # [BSS] Damping type (Lorentzian | Gaussian)
# | % BDmRange
# |  0.100000 | 0.100000 |         eV    # [BSS] Damping range
# | %
# | BEnSteps=  5001                  # [BSS] Energy steps
# | % BLongDir
# |  1.000000 | 0.000000 | 0.000000 |        # [BSS] [cc] Electric Field versor
# | %
# | BSEprop= " abs esrt indx"        # [BSS] Can be any among abs/jdos/kerr/asymm/anHAll/magn/dich/photolum/esrt/MEspin/MEorb
# | BSEdips= "none"                  # [BSS] Can be "trace/none" or "xy/xz/yz" to define off-diagonal rotation plane
# | WRbsWF                         # [BSS] Write to disk excitonic the WFs
# | BSSldiaLib= "s"                  # [BSS] Library used with ldiago solver `(s)scalapack/(e1)elpa1/(e2)elpa2`
# | BSSNEig=0                        # [SLEPC/DIAGO] Number of eigenvalues to compute
